# E2E（Playwright）専用の環境変数。`cp .env.test.example .env.test` して使う。
# .env.test が無ければこのファイルがそのまま読まれるので、ローカル Supabase を
# 起動していれば `pnpm test:e2e` は追加設定なしで通る。
#
# 前提: `pnpm supabase:start` → `pnpm supabase:reset`（ポートは supabase/config.toml の 5434x 帯）
# 注意: 本番の .env.local とは混ざらない。playwright.config.ts の webServer.env で明示注入する。

# --- ローカル Supabase --------------------------------------------------------
# anon / service_role はローカル CLI 共通の固定値（公開情報）。本番の鍵ではない。
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54341
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# --- Slack（ダミー。実 API は呼ばない） ---------------------------------------
# SLACK_SIGNING_SECRET は e2e/slack-events.spec.ts が署名生成に使うので値を合わせること。
SLACK_BOT_TOKEN=xoxb-e2e-dummy-token
SLACK_SIGNING_SECRET=e2e-slack-signing-secret
SLACK_BOT_USER_ID=U0E2EBOTUSER

# --- LLM / Embedding ----------------------------------------------------------
# 未設定のまま。E2E で外部 API を叩かせない。
# Embedding 未設定時はレポート保存後に「Embedding が未生成」警告が出る想定で、
# e2e/reports.spec.ts がその表示を検証している。

# --- E2E テストユーザー -------------------------------------------------------
# e2e/global-setup.ts が Supabase Admin API で冪等に作成する（app_metadata.role を付与）。
TEST_ADMIN_EMAIL=e2e-admin@example.test
TEST_ADMIN_PASSWORD=e2e-admin-Passw0rd!
TEST_STAFF_EMAIL=e2e-staff@example.test
TEST_STAFF_PASSWORD=e2e-staff-Passw0rd!
# ログアウト検証専用。signOut() は scope=global で全セッションを失効させるため、
# admin/staff と共有すると並列実行中の他テストのセッションを巻き添えで切ってしまう。
TEST_LOGOUT_EMAIL=e2e-logout@example.test
TEST_LOGOUT_PASSWORD=e2e-logout-Passw0rd!
